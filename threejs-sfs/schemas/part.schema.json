{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfs-threejs.local/schemas/part.schema.json",
  "title": "SFS Three.js Part Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "mass", "size", "attachment", "cost"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["capsule", "fuel_tank", "engine", "decoupler", "fairing", "parachute", "landing_leg", "rcs", "reaction_wheel"]
    },
    "mass": { "type": "number", "exclusiveMinimum": 0, "description": "Dry mass in kg." },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "bottom"],
      "properties": {
        "top": { "type": "boolean" },
        "bottom": { "type": "boolean" },
        "left": { "type": "boolean" },
        "right": { "type": "boolean" }
      }
    },
    "cost": { "type": "integer", "minimum": 0 },
    "fuel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "type"],
      "properties": {
        "capacity": { "type": "number", "minimum": 0, "description": "Propellant mass capacity in kg." },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thrust", "isp", "gimbal"],
      "properties": {
        "thrust": { "type": "number", "minimum": 0, "description": "Vacuum thrust in newtons." },
        "isp": { "type": "number", "exclusiveMinimum": 0, "description": "Specific impulse in seconds." },
        "gimbal": { "type": "number", "minimum": 0, "description": "Maximum gimbal angle in degrees." }
      }
    },
    "maxTemperature": { "type": "number", "exclusiveMinimum": 0 },
    "dragCoefficient": { "type": "number", "minimum": 0 },
    "color": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "fuel_tank" } }, "required": ["type"] },
      "then": { "required": ["fuel"] }
    },
    {
      "if": { "properties": { "type": { "const": "engine" } }, "required": ["type"] },
      "then": { "required": ["engine"] }
    }
  ]
}